&НаКлиенте
Функция ФильтрДляКоманды()
	СписокОтмеченных = СписокОтмеченныхЗаписей();
	Selection = Новый Структура();
	Selection.Вставить("MarkedAll", ОтмеченыВсе);
	Selection.Вставить("Marked", СписокОтмеченных);
	Filter = Новый Структура("Selection, Algorithm", Selection, ТекущийРаздел["Идентификатор"]);
	Для Каждого ЭлемФильтр Из ДанныеФильтра.Значения Цикл
		Filter.Вставить(ЭлемФильтр.Ключ, ЭлемФильтр.Значение);	
	КонецЦикла;
	Возврат Filter;
