&НаКлиенте
Процедура ЗаписейНаСтраницеПриИзменении(Элемент)
	ПутьКДаннымФормы = Сред(Элемент.Имя, Найти(Элемент.Имя, "_")+1);
	МодульОбъектаКлиент().ИзменитьПараметрСбис(ПутьКДаннымФормы, ЭтаФорма[ПутьКДаннымФормы]);
	ФильтрСтраница = 1;
	ОбновитьКонтент();
КонецПроцедуры

// Процедура - Обновляет поля формы
//
// Параметры:
//  СтруктураДляОбновленияФормы	 - Структура - Набор данных для обновления формы
//
Процедура ОбновитьПоляФормы(Знач СтруктураДляОбновленияФормы) Экспорт 
	
	Если НЕ ТипЗнч(СтруктураДляОбновленияФормы) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимыеТипыКоллекций = Новый Соответствие;
	ДопустимыеТипыКоллекций.Вставить(Тип("ДеревоЗначений"),		"ДеревоЗначений");
	ДопустимыеТипыКоллекций.Вставить(Тип("ТаблицаЗначений"),	"ТаблицаЗначений");
	
	Для Каждого Элемент Из СтруктураДляОбновленияФормы Цикл
		
		ТипЭлемента = ТипЗнч(ЭтаФорма.РеквизитФормыВЗначение(Элемент.Ключ));
		ПараметрыСерилизации = Новый Структура("Тип", ДопустимыеТипыКоллекций.Получить(ТипЭлемента));
		
		Если ПараметрыСерилизации.Тип = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйОбъект = МодульОбъектаСервер().СериализоватьМассивСтруктурВОбъект(Элемент.Значение, ПараметрыСерилизации);
		
		Если ПараметрыСерилизации.Тип = "ДеревоЗначений" Тогда
			Если НовыйОбъект.Строки.Количество() Тогда
				ЭтаФорма.ЗначениеВРеквизитФормы(НовыйОбъект, Элемент.Ключ);
			Иначе
				ЭтаФорма[Элемент.Ключ].ПолучитьЭлементы().Очистить();
			КонецЕсли;
		ИначеЕсли ПараметрыСерилизации.Тип = "ТаблицаЗначений" Тогда
			ЭтаФорма[Элемент.Ключ].Загрузить(НовыйОбъект);
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла; 
		
КонецПроцедуры

